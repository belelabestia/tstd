import { is, result } from '@belelabestia/tstd';

const shape = {
  email: is.string,
  age: is.number
} satisfies is.Schema;

/** the signup a payload describes, or why it is not one */
export const signup = (body: unknown) => {
  // #marco to agent: this should be "is.model(..) ?! err 'malformed body';
  // by the way, we need to discuss more in depth the emitted of ?!.
  // i'm not sure whether it should mean "not true" or "strictly false".
  // the implications of this choice shouldn't go unnoted, whatever they are.
  is.model(body, shape) ?== false err 'malformed body';
  body.age ?< 18 err 'under age';
  ok body;
};

/** the actor a request is allowed for, refused when the role is not theirs */
export const guard = (actor: string, role: string) => {
  // #marco to agent: this code could simply be replaced with
  // "=> { ok actor ?!(role == "admin") err 'not authorized'; }"
  // which showcases even better the point of using this construct.
  // the alternative would be
  // "=> { role ?!= 'admin' err 'not authorized'; ok actor; }
  // exactly the same code: two statements, or their inverted expression or exit form
  // it would be nice to have a strict, structural definition for something
  // that might be a resolved type (from an expression) or an exit instruction.
  // basically you exclude "effect" from a union "effect | exit | value"
  // what do we have about that? does the architecture of our transpiler and
  // language design have this principle? should they? could they?
  const actor2 = actor ?!(role == 'admin') err 'not authorized';
  ok actor2;
};

/** the rows worth keeping, one refusal per turn of the loop */
export const active = (rows: string[]) => {
  const out: string[] = [];

  for (const row of rows) {
    row ?none continue;
    row.length ?== 0 continue;
    void out.push(row);
  }

  return out;
};

/** a two sided choice, so it is an expression and it needs its else */
export const label = (n: number) =>
  n ?< 0 => 'below' else => n ?== 0 => 'nothing' else => 'above';

/** an answer for a case worth choosing rather than refusing */
export const clamp = (n: number) => {
  if (n < 0) return 0;
  if (n > 100) return 100;

  return n;
};

/** identity, which is all a value needs */
export const say = (code: number) => code ? {
  == 200 => 'ok',
  == 400 => 'bad request',
  else => 'something else'
};
