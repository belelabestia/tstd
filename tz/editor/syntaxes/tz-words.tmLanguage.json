{
  "name": "typezig words",
  "scopeName": "tz.words",
  "injectionSelector": "L:source.tz -comment -string",
  "patterns": [
    { "include": "#quest-block" },
    { "include": "#quest-body" },
    { "include": "#try" },
    { "include": "#scope" },
    { "include": "#protocol-decl" },
    { "include": "#protocol" },
    { "include": "#form" },
    { "include": "#call" },
    { "include": "#exit" },
    { "include": "#else" },
    { "include": "#side-quest" },
    { "include": "#binary-quest" },
    { "include": "#bare-quest" },
    { "include": "#branch" },
    { "include": "#arm" },
    { "include": "#arm-cond" }
  ],
  "repository": {
    "quest-block": {
      "begin": "(\\?)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.flow.tz" },
        "2": { "name": "punctuation.definition.block.tz" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.tz" }
      },
      "patterns": [
        { "include": "#quest-block" },
        { "include": "#quest-body" },
        { "include": "#arm" },
        { "include": "#arm-cond" },
        { "include": "#branch" },
        { "include": "#exit" },
        { "include": "#else" },
        { "include": "#side-quest" },
        { "include": "#binary-quest" },
        { "include": "#bare-quest" },
        { "include": "source.ts" }
      ]
    },
    "quest-body": {
      "begin": "(\\?)(!|none|some|ok|err|==|!=|>=|<=|>|<|&|\\||:([A-Za-z_$][\\w$]*)|\\()?((?:(?!=>)[^;`'\"\\{\\n])*?)(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.flow.tz" },
        "2": { "name": "keyword.control.flow.tz" },
        "3": { "name": "entity.name.tag.tz" },
        "5": { "name": "punctuation.definition.block.tz" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.tz" }
      },
      "patterns": [
        { "include": "#quest-block" },
        { "include": "#quest-body" },
        { "include": "#arm" },
        { "include": "#arm-cond" },
        { "include": "#branch" },
        { "include": "#exit" },
        { "include": "#else" },
        { "include": "#side-quest" },
        { "include": "#binary-quest" },
        { "include": "#bare-quest" },
        { "include": "source.ts" }
      ]
    },
    "try": {
      "match": "(?<![.$\\w'\"`])try\\b(?!['\"`])",
      "name": "keyword.control.trycatch.tz"
    },
    "scope": {
      "match": "(?<![.$\\w'\"`])scope\\b(?!['\"`])",
      "name": "keyword.control.scope.tz"
    },
    "protocol": {
      "match": "(?<![.$\\w'\"`])protocol\\b(?!['\"`])",
      "name": "keyword.control.protocol.tz"
    },
    "protocol-decl": {
      "begin": "(?<![.$\\w'\"`])(protocol)\\b(?!['\"`])(?:\\s+([A-Za-z_$][\\w$]*)|\\s*<[^\\n]*?>)",
      "beginCaptures": {
        "1": { "name": "keyword.control.protocol.tz" },
        "2": { "name": "entity.name.type.tz" }
      },
      "end": "^\\s*\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.tz" }
      },
      "patterns": [
        { "include": "#protocol-entry" },
        { "include": "#protocol-transition" },
        { "include": "#protocol-payload" }
      ]
    },
    "protocol-entry": {
      "match": "^\\s*([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": { "name": "entity.name.tag.tz" }
      }
    },
    "protocol-transition": {
      "begin": "=>",
      "end": "(?=,|\\}|$)",
      "patterns": [
        { "match": "[A-Za-z_$][\\w$]*", "name": "entity.name.tag.tz" },
        { "match": "\\|", "name": "punctuation.separator.tag.tz" }
      ]
    },
    "protocol-payload": {
      "name": "meta.type.annotation.ts",
      "begin": "<",
      "end": ">",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.begin.ts" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.ts" }
      },
      "patterns": [
        { "include": "source.ts#type" }
      ]
    },
    "exit": {
      "match": "(?<![.$\\w'\"`])(?:ok|err|async|return|break|continue)\\b(?!['\"`])",
      "name": "keyword.control.flow.tz"
    },
    "else": {
      "match": "(?<![.$\\w'\"`])else\\b(?!['\"`])",
      "name": "keyword.control.flow.tz"
    },
    "form": {
      "match": "(?<![.$\\w'\"`])form\\b(?!['\"`.])",
      "name": "keyword.control.form.tz"
    },
    "call": {
      "match": "(?<![.$\\w'\"`])call\\b(?!['\"`])",
      "name": "keyword.control.trycatch.tz"
    },
    "side-quest": {
      "match": "(\\?(?:none|some|ok|err|:|\\())([A-Za-z_$][\\w$]*)?",
      "captures": {
        "1": { "name": "keyword.control.flow.tz" },
        "2": { "name": "entity.name.tag.tz" }
      }
    },
    "binary-quest": {
      "match": "(\\?)(==|!=|>=|<=|>|<|&|\\|)",
      "captures": {
        "1": { "name": "keyword.control.flow.tz" },
        "2": { "name": "keyword.operator.comparison.tz" }
      }
    },
    "bare-quest": {
      "match": "(\\?(!)?)(?!\\s*\\{)(?=\\s|$|;|,|\\)|\\]|=>|\\{|\\(|return|ok|err|async|break|continue)",
      "captures": {
        "1": { "name": "keyword.control.flow.tz" }
      }
    },
    "branch": {
      "match": "(?<=[(,\\[=:]|=>|(?:return|ok|err)\\s)\\s*:([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": { "name": "entity.name.tag.tz" }
      }
    },
    "arm": {
      "match": "^\\s*(?:(:)([A-Za-z_$][\\w$]*)(?=\\s*(?:\\(|=>|,|;))|(else)(?=\\s*(?:\\(|=>|,|;))|(==|!=|>=|<=|>|<)(?=\\s*\\S)|([&|])(?=\\s*(?:\\(|=>|,|;)))",
      "captures": {
        "1": { "name": "punctuation.separator.tag.tz" },
        "2": { "name": "entity.name.tag.tz" },
        "3": { "name": "keyword.control.flow.tz" },
        "4": { "name": "keyword.operator.comparison.tz" },
        "5": { "name": "keyword.operator.comparison.tz" }
      }
    },
    "arm-cond": {
      "match": "^\\s*(\\()",
      "captures": {
        "1": { "name": "keyword.control.flow.tz" }
      }
    }
  }
}
