import { is, result } from '@belelabestia/tstd';

const shape = {
  email: is.string,
  age: is.number
} satisfies is.Schema;

/** the signup a payload describes, or why it is not one */
export const signup = (body: unknown) => {
  is.model(body, shape) ?== false err 'malformed body';
  body.age ?< 18 err 'under age';
  ok body;
};

/** the actor a request is allowed for, refused when the role is not theirs */
export const guard = (actor: string, role: string) => {
  const actor2 = actor ?!(role == 'admin') err 'not authorized';
  ok actor2;
};

/** the rows worth keeping, one refusal per turn of the loop */
export const active = (rows: string[]) => {
  const out: string[] = [];

  for (const row of rows) {
    row ?none continue;
    row.length ?== 0 continue;
    out.push(row);
  }

  return out;
};

/** a two sided choice, so it is an expression and it needs its else */
export const label = (n: number) =>
  n ?< 0 => 'below' else => n ?== 0 => 'nothing' else => 'above';

/** an answer for a case worth choosing rather than refusing */
export const clamp = (n: number) => {
  if (n < 0) return 0;
  if (n > 100) return 100;

  return n;
};

/** identity, which is all a value needs */
export const say = (code: number) => code ? {
  == 200 => 'ok',
  == 400 => 'bad request',
  else => 'something else'
};
