import { test } from 'node:test';
import * as assert from 'node:assert/strict';

/*
  a bare ? tests true

  a boolean subject needs no comparison spelled out: the bare `?` means
  `?== true`. a truthy non-boolean misses, so the test stays exactly
  boolean. the tail leaves or effects the way any side quest does.
*/

const ping = (cond: boolean, log: (x: string) => void) => {
  cond ? log('up');
  return cond;
};

const demand = (cond: boolean) => {
  cond ? return 'yes';
  return 'no';
};

void test('trigger an effect when true', () => {
  const seen: string[] = [];

  void ping(true, (x) => void seen.push(x));
  void ping(false, (x) => void seen.push(x));
  assert.deepEqual(seen, ['up']);
});

void test('leave early when true, and fall through when not', () => {
  assert.equal(demand(true), 'yes');
  assert.equal(demand(false), 'no');
});
