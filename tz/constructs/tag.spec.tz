import { test } from 'node:test';
import * as assert from 'node:assert/strict';
import { branch, type Result } from '@belelabestia/tstd';

/*
  ?:tag reads any branch by name, the subject left boxed

  ?ok and ?err unwrap because the complement of one branch is always the
  other. a coloned test names any branch and keeps the whole box, so the
  chain can read the payload with `.value` once the narrowing proved which
  branch it is, or test the same subject again.
*/

const quote = (out: Result<string, string>) => {
  const found = out ?:err return;
  return found.value;
};

const keep = (out: Result<string, string>) => out ?:ok => out.value;

void test('refuse a named branch and read the payload with value', () => {
  const ok = :ok('ada');
  const err = :err('down');

  assert.equal(quote(ok), 'ada');
  assert.equal(quote(err), undefined);
});

void test('match the branch you want and keep it boxed', () => {
  const ok = :ok('ada');

  assert.equal(keep(ok), 'ada');
});
