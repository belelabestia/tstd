import { test } from 'node:test';
import * as assert from 'node:assert/strict';
import { make, result } from '@belelabestia/tstd';

/*
  make is the constructor that does not throw

  `new` is banned, and its replacement takes `=>` the way `call` does,
  because a platform constructor panics. `make => C(...)` names the
  constructor and keeps the arguments where they are, and the boundary
  becomes a Result. a constructor only syncs, so there is no async side.
*/

const url = (href: string) => make => URL(href);

const built = (href: string) => {
  const u = try make => URL(href);
  ok u.href;
};

void test('build a constructor into a Result', () => {
  assert.equal(url('https://x.test/a').branch, 'ok');
  assert.equal(url('not a url').branch, 'err');
});

void test('unwrap a constructor that holds', () => {
  assert.equal(built('https://x.test/a').value, 'https://x.test/a');
  assert.equal(built('not a url').branch, 'err');
});
